attribute vec3 aSeed;
attribute vec2 aCorner;
uniform mat4 uV;
uniform mat4 uP;
uniform vec3 uEye;
uniform float uTime;
uniform float uCamZ;
uniform float uRainSpeed;
uniform float uSnow;
uniform float uWind;
varying vec2 vC;
varying float vDist;
void main(){
    vec3 pos;
    pos.x = uEye.x + (aSeed.x - 0.5) * 70.0;
    float fall = uRainSpeed * (0.8 + aSeed.z * 0.4) * mix(1.0, 0.07, uSnow);
    pos.y = uEye.y - 25.0 + mod(aSeed.y * 60.0 - uTime * fall, 60.0);
    pos.z = mod(aSeed.z * 84.0 - uCamZ, 84.0) - 4.0;
    pos.x += uSnow * sin(uTime * (0.6 + aSeed.x) + aSeed.y * 30.0) * 1.2 + uWind * 0.02 * mod(uTime * 7.0 + aSeed.z * 50.0, 60.0);
    vec3 vel = mix(vec3(-0.08 - uWind * 0.02, -1.0, 0.0), vec3(0.0, -0.06, 0.0), uSnow);
    vec3 a = (uV * vec4(pos, 1.0)).xyz;
    vec3 b = (uV * vec4(pos + vel * 0.9, 1.0)).xyz;
    vec3 seg = b - a;
    vec3 P = mix(a, b, aCorner.x);
    vec3 perp = cross(seg, P);
    float pl = length(perp);
    perp = pl > 1e-4 ? perp / pl : vec3(1.0, 0.0, 0.0);
    P += perp * aCorner.y * mix(0.018, 0.05, uSnow) + (uSnow > 0.5 ? normalize(seg + vec3(1e-4)) * (aCorner.x * 2.0 - 1.0) * 0.04 : vec3(0.0));
    vC = aCorner;
    vDist = length(P);
    gl_Position = uP * vec4(P, 1.0);
}
